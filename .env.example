# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application
APP_NAME=RoadDogs
APP_VERSION=0.3.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true  # Hot reload for development

# Database
MONGODB_URL=mongodb://localhost:27017/rd
# For production with authentication:
# MONGODB_URL=mongodb://username:password@localhost:27017/rd?authSource=admin

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
# For production with password:
# REDIS_URL=redis://:password@localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OAuth - Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback

# Logging
LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# File Paths
STATIC_PATH=sublayers_common/static
WORLD_PATH=sublayers_world

# --- Legacy Tornado stack + nginx (docker-compose only) ---
# Docker service DNS names (only resolvable inside the compose network)
GAME_ENGINE_HOST=game-engine
SITE_HOST=site-server
QUICK_HOST=quick-engine

# Each port is used both as the backend service's own --port/--ws_port
# argument and as nginx's upstream port for that service - one place to
# change a port instead of keeping several in sync.
GAME_ENGINE_PORT=8000
SITE_PORT=8001
QUICK_PORT=8005

# Host-side port nginx is published on. 8080 by default in dev to avoid
# clashing with anything else already bound to :80 on your machine; set to
# 80 on a real VDS (see docker-compose.prod.yml).
NGINX_HTTP_PORT=8080

# Secure-cookie signing keys for game-engine/quick-engine/site-server (see
# sublayers_server/settings.py, sublayers_site/settings.py). COOKIE_SECRET
# must be identical across all three - they read/write the same "user"
# cookie. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required - docker compose up fails without it. Different value per
# environment (dev machine vs. each deployment), never reused, never committed.
COOKIE_SECRET=your-cookie-secret-generate-with-python-secrets-token-hex-32
# Only needed if the (currently disabled) forum integration is ever revived.
FORUM_COOKIE_SECRET=

# Docker - MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_password
MONGO_DATABASE=rd

# Docker - Redis
REDIS_PASSWORD=redis_password

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_OAUTH=true
MAINTENANCE_MODE=false

# Rate Limiting (requests per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Email (for password reset, notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@roaddogs.com

# Monitoring
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_ENABLED=false
