# Docker-native nginx config for RoadDogs (dev and prod use the same template).
#
# Rendered by the official nginx:alpine entrypoint: any *.template file under
# /etc/nginx/templates/ is passed through `envsubst` (restricted to variables that
# are actually set in the container's environment) into /etc/nginx/conf.d/ at
# startup. See docker-compose.yml for how GAME_ENGINE_HOST/PORT, SITE_HOST/PORT
# and QUICK_HOST/PORT are set - change a port there, not here.
#
# This mirrors the historical bare-metal config at
# nginx_conf/sites-available/rd.conf, parameterized for Docker service names
# instead of hardcoded 127.0.0.1:<port>. That file remains the reference for
# non-Docker (plain systemd) deployments.
#
# No CDN: /map, /static and /audio are all served directly from disk on this
# same machine/container - see the volume mounts on the `nginx` service.

server {
    listen 80;
    server_name _;

    # Docker DNS: resolve backend container names per-request instead of once
    # at nginx startup. A bare `proxy_pass http://game-engine:8000/` resolves
    # game-engine's IP once when nginx boots and caches it for the process
    # lifetime - recreating that container (redeploy, restart) leaves nginx
    # proxying to a dead IP (404/502) until nginx itself is also restarted.
    # Routing through a variable forces nginx to re-resolve on every request.
    resolver 127.0.0.11 valid=10s;
    set $site_upstream http://${SITE_HOST}:${SITE_PORT};
    set $quick_upstream http://${QUICK_HOST}:${QUICK_PORT};
    set $game_upstream http://${GAME_ENGINE_HOST}:${GAME_ENGINE_PORT};

    # Map tiles. URL convention: /map/{layer}/{z}/{x}/{y}.png ->
    # sublayers_world/tiles/map/{layer}/{z}/{x}/{y}.png (mounted at /srv/world_tiles/map).
    location ^~ /map/ {
        root /srv/world_tiles;
        if ($query_string) {
            expires max;
        }
    }

    location ^~ /static/ {
        add_header Access-Control-Allow-Origin *;
        root /srv/static_root;
        if ($query_string) {
            expires max;
        }
    }

    location ^~ /audio/ {
        root /srv/audio_root;
        if ($query_string) {
            expires max;
        }
    }

    # Site server: landing page + auth
    location = / {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

    location ~ ^/(login|logout|email_confirm)$ {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

    location /site_api/ {
        # No URI part after the variable: with a variable in proxy_pass,
        # nginx can't do its usual "replace the matched location prefix"
        # rewrite, so a literal suffix here (e.g. "$site_upstream/site_api/")
        # gets appended in front of the *unmodified* original request URI
        # instead of replacing it - upstream saw /site_api/site_api/locale
        # and 404d. site-server's own routes already include the /site_api/
        # prefix, so passing the original URI through unchanged is correct.
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

    # Quick engine: tutorial / fast-respawn mode. quick-engine's own routes
    # (/play, /ws, /api/...) have no /quick/ prefix, so it must be stripped.
    # A variable proxy_pass can't do that via the usual "replace matched
    # prefix" trick (see /site_api/ above), so rewrite the URI explicitly
    # before handing it to proxy_pass.
    location = /quick/ws {
        rewrite ^/quick/ws$ /ws break;
        proxy_pass $quick_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    location /quick/ {
        rewrite ^/quick/(.*)$ /$1 break;
        proxy_pass $quick_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Main game engine (basic mode): WebSocket + catch-all
    location = /ws {
        proxy_pass $game_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    location / {
        # See /site_api/ above: proxy_pass with a variable disables nginx's
        # usual location-prefix rewrite, so no literal suffix here either -
        # the original request URI is passed through unchanged, which is
        # what game-engine's own routes (/play, /ws, /api/... - no prefix
        # stripping needed) expect.
        proxy_pass $game_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

    error_page 502 503 504 /50x.html;
    location = /50x.html {
        root /srv/static_root/static;
    }
}
